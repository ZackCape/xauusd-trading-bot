# ==============================================================================
# XAU/USD INTRADAY TRADING INTELLIGENCE BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MARKET DATA ENGINE SETTINGS
# ------------------------------------------------------------------------------
# Supported DATA_SOURCE values:
#   - "AUTO"     : Attempt MetaTrader 5 first; seamlessly fallback to Yahoo Finance if unavailable.
#   - "MT5"      : Enforce MetaTrader 5 only.
#   - "YFINANCE" : Bypass MetaTrader 5 and pull directly from Yahoo Finance.
DATA_SOURCE=AUTO

# MetaTrader 5 Credentials & Settings (Optional if terminal is already signed in)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD

# Yahoo Finance Tickers (Defaults: DXY = DX-Y.NYB, US 10Y Yield = ^TNX)
YF_DXY_TICKER=DX-Y.NYB
YF_US10Y_TICKER=^TNX

# ------------------------------------------------------------------------------
# 2. AI PREDICTION ENGINE (GEMINI OR OPENAI)
# ------------------------------------------------------------------------------
# Provide either GEMINI_API_KEY or OPENAI_API_KEY.
# If left empty, the bot automatically runs the deterministic institutional rule-based engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. INTERACTIVE DISCORD BOT SETTINGS
# ------------------------------------------------------------------------------
# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=

# Target Discord Channel ID for automated 15-minute scheduled forecast alerts
DISCORD_ALERT_CHANNEL_ID=

# Optional Role ID to ping on High-Conviction (>=8/10) signals or Red-Folder news risks
DISCORD_ALERT_ROLE_ID=

# ------------------------------------------------------------------------------
# 4. WEBHOOK & TELEGRAM FALLBACK DISPATCH
# ------------------------------------------------------------------------------
# Discord Webhook URL (Used for standalone alerts or fallback)
DISCORD_WEBHOOK_URL=

# Telegram Bot Dispatch (From @BotFather and your Chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
